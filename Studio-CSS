
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background-color: #09090b; 
    color: #fafafa;
}


.ustmenu {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 6%;
    background-color: rgba(9, 9, 11, 0.9);
    border-bottom: 1px solid #27272a;
    position: sticky;
    top: 0;
    z-index: 100;
}

.markalogo p {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 3px;
    color: #ffffff;
}

.markalogo span {
    font-weight: 300;
    color: #d4af37; /* Altın vurgusu */
}

.menulinkleri {
    display: flex;
    gap: 30px;
}

.menulinkleri a {
    text-decoration: none;
    color: #a1a1aa;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: color 0.3s;
}

.menulinkleri a:hover {
    color: #ffffff;
}

.sepetbuton {
    border: 1px solid #3f3f46;
    padding: 8px 18px;
    font-size: 12px;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: all 0.3s;
}

.sepetbuton:hover {
    background-color: #ffffff;
    color: #09090b;
}


.vitrinalani {
    height: 460px;
    background: radial-gradient(circle at top right, #27272a 0%, #09090b 70%);
    border-bottom: 1px solid #27272a;
    display: flex;
    align-items: center;
    padding: 0 6%;
}

.vitrinicerik {
    max-width: 600px;
}

.sezonetiketi {
    color: #d4af37;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    display: block;
    margin-bottom: 15px;
}

.vitrinbaslik {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 20px;
    letter-spacing: -1px;
}

.vitrinaciklama {
    color: #a1a1aa;
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 30px;
}

.kesfetbutonu {
    display: inline-block;
    background-color: #ffffff;
    color: #09090b;
    text-decoration: none;
    padding: 14px 32px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    transition: background-color 0.3s, transform 0.2s;
}

.kesfetbutonu:hover {
    background-color: #d4af37;
    transform: translateY(-2px);
}


.anakapsayici {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
}

.bolumust {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 35px;
    border-bottom: 1px solid #27272a;
    padding-bottom: 15px;
}

.bolumbaslik {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 1px;
}

.bolumalt {
    color: #71717a;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 2px;
}


.urunizgarasi {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
}

.urunkarti {
    background-color: #121215;
    border: 1px solid #27272a;
    transition: border-color 0.3s, transform 0.3s;
    overflow: hidden; 
}

.urunkarti:hover {
    border-color: #52525b;
    transform: translateY(-6px);
}


.urungorselkapsayici {
    height: 320px;
    position: relative;
    overflow: hidden;
    background-color: #1a1a1e;
    border-bottom: 1px solid #27272a;
}

.urunresim {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
}

.urunkarti:hover .urunresim {
    transform: scale(1.05); 
}

.yenirozet {
    position: absolute;
    top: 15px;
    left: 15px;
    background-color: #09090b;
    color: #d4af37;
    border: 1px solid #d4af37;
    font-size: 10px;
    font-weight: bold;
    padding: 4px 10px;
    letter-spacing: 1.5px;
    z-index: 10;
}

.urunbilgi {
    padding: 20px;
}

.urunkategori {
    font-size: 11px;
    color: #71717a;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
}

.urunadi {
    font-size: 16px;
    font-weight: 600;
    color: #f4f4f5;
    margin-bottom: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis; 
}

.urunfiyat {
    font-size: 18px;
    font-weight: 700;
    color: #d4af37;
    margin-bottom: 16px;
}


.bedensecimi {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
}

.bedensecimi input {
    display: none;
}

.bedensecimi span {
    display: inline-block;
    width: 34px;
    height: 34px;
    line-height: 32px;
    text-align: center;
    border: 1px solid #27272a;
    font-size: 12px;
    color: #a1a1aa;
    cursor: pointer;
    transition: all 0.2s;
}

.bedensecimi span:hover {
    border-color: #71717a;
    color: #ffffff;
}

.bedensecimi input:checked + span {
    background-color: #ffffff;
    color: #09090b;
    border-color: #ffffff;
    font-weight: bold;
}


.satinalbtn {
    width: 100%;
    text-align: center;
    padding: 12px;
    background-color: #18181b;
    border: 1px solid #3f3f46;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: all 0.3s;
}

.satinalbtn:hover {
    background-color: #d4af37;
    border-color: #d4af37;
    color: #09090b;
}


.altbilgi {
    margin-top: 80px;
    padding-top: 30px;
    border-top: 1px solid #27272a;
    display: flex;
    justify-content: space-between;
    color: #71717a;
    font-size: 13px;
}


@media (max-width: 768px) {
    .menulinkleri {
        display: none;
    }
    .vitrinbaslik {
        font-size: 34px;
    }
    .altbilgi {
        flex-direction: column;
        gap: 10px;
        text-align: center;
    }
}
